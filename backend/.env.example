PORT=3000
# Local (Docker)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=tia_app
DB_PASSWORD=
DB_NAME=trinet_invoice_ai
# Producción: mysql://usuario:clave@host:puerto/base y certificado CA del proveedor
DATABASE_URL=
DB_CA_CERT=
# Clave de la API de Anthropic (extracción de facturas)
ANTHROPIC_API_KEY=
# Google Identity Platform: id del proyecto y JSON (o ruta) de la cuenta de servicio
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
# 1 = usuarios de prueba sin Google (solo desarrollo; ignorado en producción)
DEV_AUTH=0
